cff-version: 1.2.0
title: "StochX"
version: "0.3.0rc1"
date-released: "2026-08-20"
type: software
abstract: >-
  A Python library for stochastic-process analysis, time-series modelling,
  simulation, Box-Jenkins workflows, and linear-Gaussian state-space analysis.
message: "If you use StochX in academic work, please cite this software."
authors:
  - family-names: "Alikacem"
    given-names: "Faycal"
repository-code: "https://github.com/Faycal214/stochx"
url: "https://faycal214.github.io/stochx/"
license: "MIT"
keywords:
  - stochastic processes
  - Markov chains
  - Poisson processes
  - continuous-time Markov chains
  - birth-death processes
  - conditional expectation
  - martingales
  - stochastic simulation
  - time-series analysis
  - Box-Jenkins
  - ARIMA
  - state-space models
  - Kalman filtering
  - forecasting
